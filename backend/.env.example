DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SESSION_SECRET=change-me-long-random-string
COOKIE_SECURE=false
# Values below match db/001_foundation.sql (a NEW schema). For any other database, re-verify with tools/inspect_schema.py
USERS_TABLE=office_dashboard.login_accounts
COL_ID=id
COL_NAME=full_name
COL_LOGIN=username
COL_EMAIL=email
COL_PASSWORD=password_hash
COL_ROLE=role
COL_ACTIVE=is_active
ACTIVE_VALUES=true,t,1,active
ROLE_MAP={}
ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY=false
REVOCATION_DB=sessions.sqlite3
AUDIT_LOG=audit.jsonl
# WhatsApp (backend-only; never commit real values). Provider must be confirmed: meta_cloud or third_party
WABA_PROVIDER=
WABA_ID=
WABA_PHONE_NUMBER_ID=
WABA_ACCESS_TOKEN=
WABA_BUSINESS_PHONE=9014336878
# CRM permissions (server-side). Only roles listed here can read/write CRM. There is no CCO role; assign commercial users by role.
CRM_WRITE_ROLES=ceo
CRM_READ_ROLES=ceo,coo
# Who may DELETE (soft-delete/archive) contacts and leads. Must also have CRM read access. Permanent deletion is NOT implemented.
CRM_ARCHIVE_ROLES=ceo

# EVcare.AI diagnostics (leave empty = the Diagnostics page shows "Not configured"). Server-side only; never returned to the browser.
EVCARE_AI_URL=
EVCARE_AI_API_KEY=
# Extra telemetry metric names to treat as LOCATION data (comma separated). Built-in: latitude, longitude, lat, lng, lon, altitude, heading, gps*, location*, geo*, position* ...
IOT_EXTRA_LOCATION_METRICS=